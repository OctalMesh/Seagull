{
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "trailingComma": "all",
  "bracketSpacing": true,
  "arrowParens": "always",
  "endOfLine": "lf",
  "plugins": ["@trivago/prettier-plugin-sort-imports", "prettier-plugin-yaml"],
  "importOrder": [
    "^node:",
    "<THIRD_PARTY_MODULES>",
    "^@core/(.*)$",
    "^@config/(.*)$",
    "^@generators/(.*)$",
    "^@commands/(.*)$",
    "^@/(.*)$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "yamlBlockStyle": "literal",
  "yamlCollectionStyle": "block",
  "yamlQuoteKeys": false,
  "yamlQuoteValues": true
}
