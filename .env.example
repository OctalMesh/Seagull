# ============================================================================ #
#                       Environment Variables (Local Dev)                      #
# ============================================================================ #
# This file ships with the repository and defines default runtime values.      #
# Copy it to ".env" and adjust values for your local setup.                    #
#                                                                              #
# ".env.example" is tracked in git and loaded as default config.               #
# ".env"         is intended for local overrides.                              #
#                                                                              #
# None of this is required for day-to-day development (build/lint/test need    #
# nothing here), it only matters if you want to run "pnpm run release" locally #
# instead of letting the Release GitHub Actions workflow to publish.           #
#                                                                              #
# See "RELEASING.md" for the full local-publish walkthrough.                   #
# ============================================================================ #

# npm access token with publish rights for the "@octalmesh" organization.
NPM_TOKEN=
